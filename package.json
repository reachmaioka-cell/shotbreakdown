{
  "name": "shotbreakdown",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'ulimit -n 65536 2>/dev/null; exec next dev --port 3002 --hostname 127.0.0.1'",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local scripts/apply-migrations.mjs",
    "db:seed": "npx tsx --env-file=.env.local scripts/seed-library.ts",
    "db:seed:analyze": "npx tsx --env-file=.env.local scripts/seed-library.ts --analyze",
    "db:seed:music": "npx tsx --env-file=.env.local scripts/seed-music-clips.ts",
    "db:ingest-knowledge": "npx tsx --env-file=.env.local scripts/ingest-knowledge.ts",
    "learning:worker": "npx tsx --env-file=.env.local scripts/learning-worker.ts",
    "learning:tick": "npx tsx --env-file=.env.local scripts/learning-tick.ts",
    "e2e:smoke": "npx tsx --env-file=.env.local scripts/e2e-smoke.ts",
    "http:smoke": "npx tsx --env-file=.env.local scripts/http-smoke.ts",
    "smoke": "npm run e2e:smoke && npm run http:smoke",
    "db:backfill-chunks": "npx tsx --env-file=.env.local scripts/backfill-chunks.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration.test.ts",
    "e2e:journey": "npx tsx --env-file=.env.local scripts/e2e-journey.ts",
    "pipeline:smoke": "npx tsx --env-file=.env.local scripts/pipeline-smoke.ts",
    "worker": "npx tsx --env-file=.env.local scripts/worker.ts",
    "worker:ping": "npx tsx --env-file=.env.local scripts/ping-worker.ts",
    "db:normalize-colors": "npx tsx --env-file=.env.local scripts/normalize-colors.ts",
    "db:enrich-shots": "npx tsx --env-file=.env.local scripts/enrich-shots.ts",
    "db:backfill-thumbs": "npx tsx --env-file=.env.local scripts/backfill-frame-thumbs.ts",
    "db:library-health": "npx tsx --env-file=.env.local scripts/library-health.ts",
    "db:recreation-guide": "npx tsx --env-file=.env.local scripts/generate-recreation-guide.ts",
    "segment:journey": "npx tsx --env-file=.env.local scripts/segment-journey.ts",
    "full:journey": "npx tsx --env-file=.env.local scripts/full-journey.ts",
    "security:audit": "npx tsx --env-file=.env.local scripts/security-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "fluent-ffmpeg": "^2.1.3",
    "next": "16.3.4",
    "postgres": "^3.4.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
